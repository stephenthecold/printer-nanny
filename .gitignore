# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Local DB / env
*.sqlite3
*.db
.env
.env.local
# The SECRET_KEY central generates when the environment supplies none
# (central/config.py:resolve_secret_key). It lands beside the SQLite database,
# which for the default DATABASE_URL is the repository root -- so any local
# `alembic`, `seed` or `uvicorn` run drops a live credential into the checkout.
# Untracked AND unignored is the dangerous combination: `git add -A` commits it.
.printer-nanny-secret-key

# Local compose customisation. Deliberately untracked so `install.sh --update`
# can fast-forward docker-compose.yml underneath it without ever colliding.
# Start from docker-compose.override.yml.example (which IS tracked).
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml
# Backups install.sh --migrate-compose takes before resetting a hand-edited file
docker-compose.yml.bak.*

# Agent self-update marker (runtime artifact, never source)
.pn-update-result.json

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Graphify knowledge-graph output (`graphify extract .`). Regenerable from the
# tree in one command, ~21MB per build, and rewritten wholesale on every run --
# so it is pure merge conflict with no history worth keeping.
graphify-out/

# OS / editors
.DS_Store
.idea/
.vscode/

# Agent worktrees (scratch checkouts, never part of the tree)
.claude/worktrees/

# Frontend build scratch. scripts/build-assets.sh builds in a temp dir precisely
# so this never appears, but a developer running npm by hand in the repo would
# otherwise have it swept into the image by deploy/Dockerfile's `COPY . .`.
node_modules/
