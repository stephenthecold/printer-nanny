# Copy to .env. Only these two are needed — everything else (SMTP, FreeScout,
# alert thresholds, polling intervals, SNMP defaults, SSO) is managed in the UI
# under Settings and stored in the database.

# Leave unset to use a local SQLite file (dev/tests). Production (Docker Compose)
# uses Postgres:
# DATABASE_URL=postgresql+psycopg://nanny:nanny@db:5432/printer_nanny
DATABASE_URL=sqlite:///./printer_nanny.sqlite3

# Session signing secret for the dashboard. CHANGE THIS in production.
SECRET_KEY=dev-insecure-change-me

# Log verbosity for the api and worker containers (DEBUG / INFO / WARNING /
# ERROR). Read from the environment rather than the Settings page because the
# first thing worth logging is a database that will not answer.
#
# It moves PRINTER NANNY's loggers only, never a dependency's. That is
# deliberate: httpx logs the full request URL at INFO and a Slack / Teams /
# webhook URL is itself the credential, and SQLAlchemy logs every statement with
# its bound parameters at DEBUG. So DEBUG here is safe to leave on while you
# reproduce something.
# LOG_LEVEL=INFO

# --- Optional bootstrap defaults ---------------------------------------------
# These seed the initial values on the Settings page the first time the app runs.
# After that, edit them in the UI (Settings) — no need to keep them here.
# AGENT_OFFLINE_GRACE_SECONDS=300
# SMTP_HOST=mailhog
# SMTP_PORT=1025
# SMTP_FROM=printer-nanny@example.com

# --- Docker Compose deployment knobs -----------------------------------------
# Only read by docker-compose.yml, not by the app. Set them here rather than
# editing docker-compose.yml: the installer fast-forwards that file on every
# `--update`, so local edits to it collide with upstream changes and wedge the
# update. Anything these can't express belongs in docker-compose.override.yml
# (copy docker-compose.override.yml.example).

# Postgres credentials for the bundled db service.
#
#   !! ONLY APPLIED WHEN THE DATA DIRECTORY IS FIRST CREATED. !!
#
# The postgres image reads these when it initialises an empty pgdata volume and
# never again. Changing POSTGRES_PASSWORD on a running install therefore does
# NOT re-key the database — it only changes the password api/worker present,
# which the unchanged database then rejects, and the stack comes back up with
# api/worker unable to connect. To rotate on an existing install, change it in
# the database first and then here:
#   docker compose exec db psql -U nanny -d printer_nanny \
#       -c "ALTER USER nanny WITH PASSWORD 'new-password';"
#   # then set POSTGRES_PASSWORD below and: bash deploy/install.sh --update
# The password rides inside a URL (DATABASE_URL), so keep it URL-safe —
# no @ : / ? # % characters. install.sh generates one that already is.
# POSTGRES_USER=nanny
# POSTGRES_PASSWORD=nanny
# POSTGRES_DB=printer_nanny

# Host port the API binds for your own reverse proxy (external-proxy mode).
# API_PORT=8000

# Worker cycle length in seconds. The worker's healthcheck derives its staleness
# threshold from this, so raising it does not cause false unhealthy reports.
# WORKER_INTERVAL=60

# Image pins. Override to stay on a known-good tag or to use a private mirror.
# POSTGRES_IMAGE=postgres:16-alpine
# CADDY_IMAGE=caddy:2-alpine
# MAILHOG_IMAGE=mailhog/mailhog

# Mailhog is a DEV SMTP catcher — it accepts unauthenticated mail and serves an
# unauthenticated web UI of everything it caught. It is opt-in for that reason.
# Set to 1 to have install.sh bring it up (equivalent to --profile mailhog).
# MAILHOG_PROFILE=1
# MAILHOG_UI_PORT=8025

# Written by install.sh when you pick the bundled-Caddy path; listed here so the
# file is self-documenting. Edit via `install.sh --reset-caddy`, not by hand.
# CADDY_PROFILE=1
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
# PN_HOSTNAME=printers.msp.example.com
# PN_ACME_EMAIL=ops@msp.example.com
